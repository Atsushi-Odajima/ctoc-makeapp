{
  "name": "ctoc-makeapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:backup": "ts-node --project tsconfig.scripts.json scripts/db-backup.ts",
    "db:copy-sqlite": "ts-node --project tsconfig.scripts.json scripts/copy-sqlite-to-postgres.ts",
    "db:compare": "ts-node --project tsconfig.scripts.json scripts/db-compare.ts",
    "db:report-duplicates": "ts-node --project tsconfig.scripts.json scripts/report-duplicate-conversations.ts",
    "seed:options": "ts-node --project tsconfig.scripts.json scripts/seed-options.ts",
    "seed:demo": "ts-node --project tsconfig.scripts.json scripts/seed-demo.ts",
    "media:backfill-legacy": "ts-node --project tsconfig.scripts.json scripts/media-backfill-legacy.ts",
    "media:migrate-legacy": "ts-node --project tsconfig.scripts.json scripts/media-migrate-legacy.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}

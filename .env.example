# DayNet environment variables. Copy to .env.local (read by `next dev`, Prisma CLI and scripts —
# see scripts/lib/load-env.cjs). Never commit real values. Use SEPARATE values for Vercel
# Preview and Production (DB, Cloudinary environment, auth secrets, OAuth redirect URLs).

# --- Database (PostgreSQL / Neon) -----------------------------------------------------------
# Pooled connection for the app (Neon: the "-pooler" host, add ?sslmode=require&pgbouncer=true)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/daynet?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection used by `prisma migrate deploy` and the backup/copy tools
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/daynet?sslmode=require"

# --- Auth (Auth.js / NextAuth v5) ------------------------------------------------------------
# openssl rand -base64 32   (NEXTAUTH_SECRET is still accepted for compatibility)
AUTH_SECRET=""
# Needed when not running on Vercel (e.g. `next start` on a LAN machine)
AUTH_TRUST_HOST="true"
# Public origin of this deployment (used for webhooks, metadata and the Origin/CSRF check)
APP_ORIGIN="http://localhost:3000"
# Optional extra allowed origins for the Origin check, comma separated
EXTRA_ALLOWED_ORIGINS=""

# OAuth providers are enabled ONLY when both id and secret are set (names unchanged).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
LINE_CLIENT_ID=""
LINE_CLIENT_SECRET=""

# --- Media -----------------------------------------------------------------------------------
# cloudinary (default) or local. "local" = development/E2E only, refuses to run on Vercel.
MEDIA_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Token-based (authenticated) delivery key from the Cloudinary console — server only,
# hex, and DIFFERENT from CLOUDINARY_API_SECRET. Requires a plan/feature that supports
# token-based access. Without it, uploads are refused (no public-URL fallback).
CLOUDINARY_AUTH_TOKEN_KEY=""
# Folder for NEW authenticated assets (legacy public assets stay where they are)
CLOUDINARY_FOLDER="daynet/media"
# HMAC secret (>= 32 chars) for short-lived local/legacy media URLs
MEDIA_URL_SECRET=""

# --- Jobs ------------------------------------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/*
CRON_SECRET=""

# --- Optional --------------------------------------------------------------------------------
# Link target for the CinemiX sibling note (no data exchange). Leave empty to show plain text.
NEXT_PUBLIC_CINEMIX_URL=""
# Register the service worker in `next dev` too (it is always registered in production)
NEXT_PUBLIC_ENABLE_SW=""
# Test environments only: multiply all rate limits (never set in Preview/Production)
RATE_LIMIT_SCALE=""
